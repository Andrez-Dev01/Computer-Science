# Personal Obsidian local settings (usually machine-specific)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.obsidian/plugins/
.trash/

# Keep restricted or private source materials LOCAL, out of the public repo
_local-only/
_private/
**/private-assets/

# Do not upload book/course scans, licensed ebooks, or exported material
*.pdf
*.epub
*.mobi
*.azw
*.azw3
*.djvu
*.ppt
*.pptx
*.key

# Secrets, authentication, personal metadata
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.sqlite
*.db
.DS_Store
Thumbs.db

# NOTE: Git ignores only untracked files. Content already committed must be
# removed from Git history separately, and paid material pasted into .md files
# is NOT protected by these patterns. Review all files before public push.
